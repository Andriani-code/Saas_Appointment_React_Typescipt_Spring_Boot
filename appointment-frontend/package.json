{
  "name": "appointment-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:css": "node ./scripts/check-contrast.mjs",
    "test": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run src/components/appointment/AppointmentCard.test.tsx src/hooks/usePaginatedFetch.test.tsx src/services/apiClient.test.ts --maxWorkers=1 --pool=threads",
    "test:coverage": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run src/components/appointment/AppointmentCard.test.tsx src/hooks/usePaginatedFetch.test.tsx src/services/apiClient.test.ts --coverage --maxWorkers=1 --pool=threads",
    "test:watch": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs --maxWorkers=1 --pool=threads",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.24.0",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.39",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vitest": "^4.1.5"
  }
}
