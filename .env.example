# ── Docker Compose environment variables (copy to .env, then edit) ──────────
# docker compose up -d --build

# JWT secret (obligatoire — générer avec: openssl rand -base64 64)
JWT_SECRET=KS0AGPpgwhEEB9MwBwWm1SIhZt+hAI9yNs7p4pcTwInS2//3/pIj1yxY7gByv5RRjdulqdlxkkEen17cV/yN8A==

# Stripe (optional — payments stay disabled until a real key is set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP / email notifications (optional — emails stay disabled until set)
MAIL_USERNAME=
MAIL_PASSWORD=

# Seed de données de démo au démarrage (true uniquement en dev/démo)
APP_SEED_ENABLED=true

export R2_ACCESS_KEY_ID=<votre Access Key ID>
export R2_SECRET_ACCESS_KEY=<votre Secret Access Key>
export R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
export R2_BUCKET_NAME=<nom du bucket>
export R2_REGION=auto

